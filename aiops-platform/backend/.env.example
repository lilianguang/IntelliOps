# AIOps 智能运维平台 - .env 模板
# 复制此文件为 .env 并修改配置

# MySQL
MYSQL_DSN=mysql+aiomysql://aiops:password@mysql:3306/aiops

# Redis
REDIS_URL=redis://redis:6379/0

# Elasticsearch
ES_HOSTS=192.67.0.230:9200

# 大模型（默认配置，可在后台修改）
LLM_DEFAULT_MODEL=qwen3
LLM_API_BASE=
LLM_API_KEY=

# JWT
JWT_SECRET=change-this-to-a-random-secret-key

# 调试模式
DEBUG=false